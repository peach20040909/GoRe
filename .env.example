# 고리 (Go:RE) 실행에 필요한 환경변수
# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. (.env.local 은 깃에 올라가지 않습니다)
# 키는 깃·단톡방에 올리지 말고 개인 메시지로만 주고받습니다.

# ── AI (사진·글 이해, 기억 카드 생성, 재방문 판정) ──────────────
# AI 키가 하나도 없으면 시연용 예시(mock) 응답으로 동작합니다.
# AI_PROVIDER: openai | anthropic | mock  (비우면 키가 있는 쪽을 자동 선택)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── DB·사진 저장 (Supabase) ─ 서버에서만 사용, NEXT_PUBLIC_ 금지 ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 네이버 지도 (브라우저용 Client ID) ────────────────────────
# 네이버 클라우드 콘솔의 'Web 서비스 URL'에 접속 주소(예: http://localhost:3000)를 등록해야 지도가 뜹니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# ── 관리자 ──────────────────────────────────────────────────
# 장소 좌표 등록 API용 임의의 문자열
ADMIN_KEY=

# ── 표시 이름 (선택) ─ 비우면 "고리 Go:RE" ──────────────────────
NEXT_PUBLIC_APP_NAME=
